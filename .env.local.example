# Developer-local test settings. Copy to `.env.local` (gitignored) and edit.
#
#     cp .env.local.example .env.local
#
# Read by `crucible_core::test_support::test_env`. Only `#[ignore]`d tests use
# these — `just ci` never does — so an absent file costs nothing but a printed
# SKIPPED line. A real environment variable overrides the file, so a one-off
# run can point somewhere else without editing anything:
#
#     CRUCIBLE_TEST_LLM_ENDPOINT=http://otherbox:11434 just test ignored

# ── Embedding tests (crucible-daemon/tests/llm_backend_comparison.rs) ────────
# Base URL of a server speaking OLLAMA'S NATIVE API — the provider appends
# `/api/embeddings` itself, so this must NOT end in `/v1`. Ollama serves it at
# :11434; llama-swap and friends serve it alongside their `/v1` routes.
CRUCIBLE_TEST_LLM_ENDPOINT=http://localhost:11434

# The embedding model to ask for, and how many dimensions it returns. The
# dimension is checked, so a model swap that silently changes it is caught
# rather than absorbed.
CRUCIBLE_TEST_EMBED_MODEL=nomic-embed-text
CRUCIBLE_TEST_EMBED_DIMS=768

# ── TUI PTY tests (crucible-cli/tests/tui_e2e_tests/) ───────────────────────
# A config.toml whose default provider actually answers. The PTY harness spawns
# `cru chat` with a hermetic environment, so it cannot see ~/.config — the path
# has to be named here.
#
# Point this at a config with a CHEAP default model. These tests stream real
# completions, and there are a dozen of them.
CRUCIBLE_TEST_CONFIG=/home/you/.config/crucible/config.toml
