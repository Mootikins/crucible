            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "changed"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "path",
              "type"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "deleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "from",
              "to",
              "type"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "moved"
                ]
              }
            }
          }
        ],
        "description": "A filesystem change delivered to the browser.\n\nSerializes with an internal `type` tag whose values are `changed` /\n`deleted` / `moved` (e.g. `{\"type\":\"changed\",\"path\":\"/abs\",\"kind\":\"modified\"}`).\nThe SSE `event:` name is separate — see [`FsEvent::event_name`]."
      },
      "ModelsResponse": {
        "type": "object",
        "description": "Response for model listings — the session-scoped `list_models` and the\nsession-less `list_all_models` return the same `{ models: [...] }` shape.",
        "required": [
          "models"
        ],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PrecognitionNote": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "relevance": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "PublicationChangedEvent": {
        "type": "object",
        "description": "A plugin's published data changed, delivered to the browser.\n\nCarries who published and under which key, never the value — the same\ncontract the daemon event has, and for the same reason: a publication is\nopaque JSON of the plugin's own choosing. The browser refetches through\n`GET /api/plugins/publications`.\n\nProjected through a named type rather than passed through as raw `data`,\nwhich is the treatment `SurfaceChangedEvent` already gets: a field the\ndaemon renames then breaks the browser with nothing on this side to notice.",
        "required": [
          "plugin",
          "key"
        ],
        "properties": {
          "plugin": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        }
      },
