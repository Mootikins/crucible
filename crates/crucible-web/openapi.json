          {
            "type": "object",
            "required": [
              "content",
              "type"
            ],
            "properties": {
              "content": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "thinking"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A text segment that streamed before a tool call, carrying the turn's\n`message_id`, its 0-based `index`, and the segment text. Lets the\nfrontend materialize a canonical per-segment bubble that matches\nhistory reconstruction.",
            "required": [
              "message_id",
              "index",
              "content",
              "type"
            ],
            "properties": {
              "message_id": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "content": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "segment_complete"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "content",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "prompt_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "completion_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "cache_read_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "cache_creation_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "minimum": 0
              },
              "stop_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Why the turn ended (`end_turn`, `max_tokens`, `refusal`, …). The\nbrowser reads it to style the turn. Absent when the daemon\nreported none.\n\nIt is a `String` in the document because `StopReason` lives in\n`crucible-core`, which takes no utoipa dependency. The values are\n`StopReason::ALL`, serialised snake_case."
              },
              "stop_notice": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The note the browser draws under a reply the provider cut off, or\nabsent when the reason needs none — which is every normal turn.\n\n**The daemon words it, not the page.** `StopReason::user_notice`\nis the only wording; the browser held a second one in TypeScript\nand the two drifted. One `Option<String>` once per turn is cheaper\nthan a wording nothing compares, and `AGENTS.md` puts the decision\nin the daemon for exactly this reason: a web front end must not\nduplicate it."
              },
              "type": {
                "type": "string",
                "enum": [
                  "message_complete"
                ]
              }
            }
