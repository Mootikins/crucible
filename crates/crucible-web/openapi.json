{
  "openapi": "3.1.0",
  "info": {
    "title": "Crucible web API",
    "description": "The HTTP API that `cru web` serves. This document is generated from the axum router; do not edit it by hand.",
    "version": "0.30.0"
  },
  "paths": {
    "/api/chat/events/{session_id}": {
      "get": {
        "summary": "The session's live event stream.",
        "description": "The body schema describes one SSE `data:` payload, not the whole stream:\nOpenAPI has no way to say \"many of these, one per line\".",
        "operationId": "event_stream",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "The session to stream",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ChatEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/fs/events": {
      "get": {
        "summary": "Live filesystem-change stream for the file-tree explorer.",
        "description": "The body schema describes one SSE `data:` payload, not the whole stream.",
        "operationId": "fs_event_stream",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/FsEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "summary": "All chat models across providers, no session required (draft-state picker).",
        "description": "Takes no `kiln` parameter, for the reason `list_providers` does not: it\nused to accept a raw `PathBuf` that reached the daemon's classification\nresolver unfloored, and no caller ever sent one.",
        "operationId": "list_all_models",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/plugins/events": {
      "get": {
        "summary": "`GET /api/plugins/events` — a push when a plugin's published data changes.",
        "description": "The counterpart to `GET /api/plugins/publications`: that answers \"what is\ntrue now\", this says \"read it again\". A panel drawing a plugin's own state\nwould otherwise poll on a timer and still show a stale value between ticks.\n\nSame shape as the file-tree stream in `routes/fs.rs`, including the\nload-bearing ordering: subscribe the LOCAL broker channel before telling the\ndaemon to forward, because `EventBroker::dispatch` drops events for a\nsession id with no local subscriber and the window between the two calls\nwould lose the first event.",
        "operationId": "publication_event_stream",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationChangedEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/shell/exec": {
      "post": {
        "summary": "Run one command and stream its output.",
        "description": "The router nests under `/api/shell`, so the document reads this path as\n`/api/shell/exec`. The body schema describes one SSE `data:` payload, not\nthe whole stream.",
        "operationId": "shell_exec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShellExecRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ShellEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/surfaces/events": {
      "get": {
        "summary": "Live stream of surface changes.",
        "description": "The body schema describes one SSE `data:` payload, not the whole stream.",
        "operationId": "surface_event_stream",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SurfaceChangedEvent"
                }
              }
            }
          }
        }
      }
    }
  },
