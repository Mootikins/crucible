      "SurfaceChangedEvent": {
        "type": "object",
        "description": "A surface changed, delivered to the browser.\n\nCarries the identity and the new version, never the rows — the same contract\nthe daemon event has, and for the same reason: a surface is unbounded where an\nevent is not, and two clients want it at different moments. The browser\nrefetches through `GET /api/surfaces`.",
        "required": [
          "plugin",
          "name",
          "version"
        ],
        "properties": {
          "plugin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "session": {
            "type": [
              "string",
              "null"
            ]
          },
          "withdrawn": {
            "type": "boolean",
            "description": "The surface is gone, so the browser drops it instead of refetching.\n\nPassed through rather than re-derived. The daemon knew this when it\ndropped the entry, and a browser that had to ask `GET /api/surfaces`\nto find out would pay a round trip for a fact the event already held."
          }
        }
      }
