{
  "version": "1.14.2",
  "transport": "running native table view summary evaluation",
  "base": {
    "filters": "file.inFolder('cases')",
    "formulas": {
      "when": "date('2024-01-01') + duration(score + 'd')"
    },
    "views": [
      {
        "type": "table",
        "name": "Case",
        "order": [
          "file.name",
          "note.score",
          "note.checked",
          "note.labels",
          "formula.when"
        ],
        "groupBy": {
          "property": "note.status",
          "direction": "ASC"
        }
      }
    ]
  },
  "summaries": [
    {
      "name": "Average",
      "property": "note.score",
      "all": "3.33",
      "empty": "null",
      "groups": [
        {
          "group": "done",
          "value": "4"
        },
        {
          "group": "todo",
          "value": "3"
        }
      ]
    },
    {
      "name": "Min",
      "property": "note.score",
      "all": "2",
      "empty": "null",
