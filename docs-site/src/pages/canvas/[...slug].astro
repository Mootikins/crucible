---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import CanvasBoard from '../../components/CanvasBoard.astro';
import { listCanvases } from '../../lib/canvas-pages.mjs';
import { remarkKilnWikilinks } from '../../plugins/remark-kiln-wikilinks.mjs';

/**
 * The site's base path, without its trailing slash.
 *
 * Read from Astro rather than repeated as a literal: `getStaticPaths` is
 * HOISTED above the rest of this frontmatter, so it cannot see a const declared
 * here — and a second copy of the base is exactly the thing that goes stale.
 */
const base = () => import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * One page per publishable `.canvas` board.
 *
 * `StarlightPage` rather than a bare layout so a board arrives inside the same
 * chrome as every other page — sidebar, search, theme toggle — instead of
 * being a differently-shaped island the reader has to navigate back out of.
 */
export async function getStaticPaths() {
	const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
	const canvases = listCanvases();

	// Text cards are markdown and must resolve wikilinks exactly as note bodies
	// do, so they go through a processor carrying the same plugin rather than a
	// second, subtly different renderer.
	const processor = await createMarkdownProcessor({
		remarkPlugins: [[remarkKilnWikilinks, { base: BASE }]],
	});

	return Promise.all(
		canvases.map(async (canvas) => {
			const textHtml: Record<string, string> = {};
			for (const node of canvas.doc.nodes) {
				if (node.type !== 'text') continue;
				const rendered = await processor.render(node.text ?? '');
				textHtml[node.id] = rendered.code;
			}
			return {
				params: { slug: canvas.slug },
				props: { canvas, textHtml },
			};
		}),
	);
}

const { canvas, textHtml } = Astro.props;
const BASE = base();
---

<StarlightPage
	frontmatter={{
		title: canvas.title,
		description: `A canvas from the Crucible documentation kiln.`,
		tableOfContents: false,
		template: 'splash',
	}}
>
	<p class="canvas-hint">
		A <a href={`${BASE}/help/concepts/canvas/`}>JSON Canvas</a> board, read-only. Drag to pan;
		hold <kbd>Ctrl</kbd> and scroll to zoom.
	</p>

	<CanvasBoard doc={canvas.doc} base={BASE} textHtml={textHtml} />
</StarlightPage>
