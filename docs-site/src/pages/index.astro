---
// Landing page — bypasses the Starlight layout entirely, but shares its design
// tokens so the two halves of the site read as one thing.
import '../styles/tokens.css';
import HeroGraph from '../components/HeroGraph.astro';
import { getDocGraph } from '../lib/docgraph.mjs';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const INSTALL =
	'curl -fsSL https://github.com/Mootikins/crucible/releases/latest/download/crucible-cli-installer.sh | sh';

// The hero constellation is the real documentation graph, not decoration.
// Only the best-connected pages are drawn: all 84 nodes behind a headline is a
// hairball, and the shape stops being readable well before it stops being busy.
const { nodes, edges } = await getDocGraph();
const ranked = [...nodes]
	.map((n) => ({ ...n, degree: n.inbound.length + n.outbound.length }))
	.sort((a, b) => b.degree - a.degree)
	.slice(0, 34);
const keep = new Set(ranked.map((n) => n.slug));
const heroNodes = ranked.map(({ slug, section, degree }) => ({ slug, section, degree }));
const heroEdges = edges.filter((e) => keep.has(e.from) && keep.has(e.to));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Crucible — A Knowledge-Grounded Agent Runtime</title>
		<meta
			name="description"
			content="Agents that draw from a knowledge graph make better decisions. Local-first, plaintext-first, no lock-in."
		/>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				background: var(--cru-ink);
				color: var(--cru-bright);
				font-family: var(--cru-font-body);
				scroll-behavior: smooth;
				-webkit-font-smoothing: antialiased;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}

			/* Film grain. Keeps large flat fields of near-black from banding on
			   cheap panels, and lends the page the tooth of printed paper. */
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: 9999;
				pointer-events: none;
				opacity: 0.03;
				background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
				background-repeat: repeat;
				background-size: 256px;
			}

			:focus-visible {
				outline: 2px solid var(--cru-ember);
				outline-offset: 3px;
				border-radius: 2px;
			}

			.skip-link {
				position: absolute;
				left: 1rem;
				top: -3rem;
				z-index: 200;
				background: var(--cru-ember);
				color: var(--cru-ink);
				padding: 0.6rem 1rem;
				border-radius: 4px;
				font-weight: 600;
				text-decoration: none;
				transition: top var(--cru-quick) var(--cru-ease);
			}
			.skip-link:focus {
				top: 1rem;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			/* ── Shared type devices ──────────────────────────────────
			   Mono + caps + wide tracking is the site's one repeating
			   structural mark. It labels machine-side text: eyebrows,
			   field labels, terminal chrome. Nothing else uses it. */
			.label {
				font-family: var(--cru-font-mono);
				font-size: var(--cru-size-micro);
				font-weight: 500;
				letter-spacing: var(--cru-track-label);
				text-transform: uppercase;
				color: var(--cru-ember);
			}

			.display {
				font-family: var(--cru-font-display);
				font-weight: 500;
				letter-spacing: var(--cru-track-display);
				line-height: 1.04;
				color: var(--cru-bright);
			}

			/* ── Nav ──────────────────────────────────────────────── */
			.nav {
				position: fixed;
				inset: 0 0 auto 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 2rem;
				background: rgba(10, 10, 12, 0.72);
				backdrop-filter: blur(14px);
				border-bottom: 1px solid var(--cru-rule);
			}

			.nav-brand {
				font-family: var(--cru-font-display);
				font-size: 1.3rem;
				font-weight: 600;
				color: var(--cru-ember);
				text-decoration: none;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				align-items: center;
				list-style: none;
			}

			.nav-links a {
				font-family: var(--cru-font-mono);
				color: var(--cru-ash);
				text-decoration: none;
				font-size: var(--cru-size-micro);
				letter-spacing: var(--cru-track-label);
				text-transform: uppercase;
				transition: color var(--cru-quick) var(--cru-ease);
			}
			.nav-links a:hover {
				color: var(--cru-bright);
			}

			.nav-links .nav-cta {
				background: var(--cru-ember);
				color: var(--cru-ink);
				padding: 0.5rem 1.1rem;
				border-radius: 4px;
				transition:
					background var(--cru-quick) var(--cru-ease),
					transform var(--cru-quick) var(--cru-ease);
			}
			.nav-links .nav-cta:hover {
				background: var(--cru-flame);
				color: var(--cru-ink);
				transform: translateY(-1px);
			}

			/* ── Hero ─────────────────────────────────────────────── */
			.hero {
				position: relative;
				min-height: 100vh;
				display: flex;
				align-items: center;
				padding: 9rem 0 5rem;
				overflow: hidden;
			}

			.hero-inner {
				position: relative;
				z-index: 2;
				width: 100%;
				max-width: 1240px;
				margin: 0 auto;
				padding: 0 2rem;
			}

			.hero-copy {
				max-width: 36rem;
			}

			.hero-eyebrow {
				display: inline-block;
				border: 1px solid var(--cru-ember-edge);
				background: var(--cru-ember-wash);
				padding: 0.4rem 0.9rem;
				border-radius: 100px;
				margin-bottom: 1.75rem;
			}

			.hero h1 {
				font-size: var(--cru-size-hero);
				text-transform: uppercase;
				margin-bottom: 1.5rem;
			}
			.hero h1 em {
				font-style: italic;
				color: var(--cru-ember);
			}

			.hero-sub {
				font-size: var(--cru-size-lead);
				line-height: 1.65;
				color: var(--cru-ash);
				max-width: 32rem;
				margin-bottom: 2.25rem;
			}

			/* The engraving, kept whole. The plate is a tondo, and cropping it
			   turns a medallion into a rectangle that happens to have curved
			   content — the circle has to close for the constellation's edges to
			   have a rim to land on. */
			.hero-art {
				position: absolute;
				z-index: 1;
				top: 50%;
				right: 4%;
				width: min(38vw, 520px);
				transform: translateY(-50%);
				pointer-events: none;
			}
			.hero-art img {
				display: block;
				width: 100%;
				height: auto;
				/* Held back so the headline wins the contrast fight. The plate is
				   dense enough that at full strength it reads as the subject and
				   the type reads as a caption. */
				opacity: 0.9;
			}
			/* No glow behind the disc: the art is opaque with the page colour
			   baked in, so its square corners occlude anything drawn underneath
			   and the crop shows as a faint box. The plate's own edge falloff
			   already seats it. */

			/* ── Buttons ──────────────────────────────────────────── */
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.6rem;
				border-radius: 5px;
				font-size: var(--cru-size-small);
				font-weight: 600;
				text-decoration: none;
				border: 1px solid transparent;
				transition:
					background var(--cru-quick) var(--cru-ease),
					border-color var(--cru-quick) var(--cru-ease),
					color var(--cru-quick) var(--cru-ease),
					transform var(--cru-quick) var(--cru-ease);
			}

			.btn-primary {
				background: var(--cru-ember);
				color: var(--cru-ink);
			}
			.btn-primary:hover {
				background: var(--cru-flame);
				transform: translateY(-1px);
			}

			.btn-ghost {
				background: transparent;
				color: var(--cru-ash);
				border-color: var(--cru-rule-lit);
			}
			.btn-ghost:hover {
				color: var(--cru-bright);
				border-color: var(--cru-ember-edge);
				transform: translateY(-1px);
			}

			/* ── Install ──────────────────────────────────────────── */
			.install {
				position: relative;
				background: rgba(17, 17, 20, 0.82);
				border: 1px solid var(--cru-rule);
				border-left: 2px solid var(--cru-ember);
				border-radius: 4px;
				padding: 0.9rem 6rem 0.9rem 1.1rem;
				margin-bottom: 1.75rem;
			}
			.install .label {
				color: var(--cru-dim);
				display: block;
				margin-bottom: 0.4rem;
			}
			.install code {
				font-family: var(--cru-font-mono);
				font-size: 0.8rem;
				line-height: 1.5;
				color: var(--cru-flame);
				word-break: break-all;
				user-select: all;
			}
			.install-copy {
				position: absolute;
				top: 0.8rem;
				right: 0.8rem;
				background: none;
				border: 1px solid var(--cru-rule-lit);
				color: var(--cru-ash);
				padding: 0.3rem 0.6rem;
				border-radius: 3px;
				cursor: pointer;
				font-family: var(--cru-font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				transition:
					border-color var(--cru-quick) var(--cru-ease),
					color var(--cru-quick) var(--cru-ease);
			}
			.install-copy:hover {
				border-color: var(--cru-ember);
				color: var(--cru-ember);
			}

			/* ── Sections ─────────────────────────────────────────── */
			.band {
				padding: 7rem 0;
			}
			.band-sunk {
				background: var(--cru-pitch);
				border-top: 1px solid var(--cru-rule);
				border-bottom: 1px solid var(--cru-rule);
			}

			.wrap {
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 2rem;
			}

			.band-head {
				margin-bottom: 3.5rem;
			}
			.band-head .label {
				display: block;
				margin-bottom: 0.9rem;
			}
			.band-head h2 {
				font-size: var(--cru-size-title);
				margin-bottom: 1rem;
			}
			.band-head p {
				font-size: var(--cru-size-lead);
				color: var(--cru-ash);
				max-width: 34rem;
				line-height: 1.65;
			}

			/* ── Features ─────────────────────────────────────────── */
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				background: var(--cru-rule);
				border: 1px solid var(--cru-rule);
				border-radius: 6px;
				overflow: hidden;
			}

			.feature {
				background: var(--cru-char);
				padding: 2rem 1.75rem;
				transition: background var(--cru-slow) var(--cru-ease);
			}
			.feature:hover {
				background: var(--cru-char-lit);
			}

			.feature-mark {
				width: 34px;
				height: 34px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 5px;
				background: var(--cru-ember-wash);
				border: 1px solid var(--cru-ember-edge);
				color: var(--cru-ember);
				margin-bottom: 1.25rem;
			}

			.feature h3 {
				font-family: var(--cru-font-body);
				font-size: 0.95rem;
				font-weight: 600;
				margin-bottom: 0.55rem;
				color: var(--cru-bright);
			}
			.feature p {
				font-size: var(--cru-size-small);
				line-height: 1.65;
				color: var(--cru-ash);
			}

			/* ── Terminal frames ──────────────────────────────────── */
			.frame {
				border: 1px solid var(--cru-rule);
				border-radius: 6px;
				overflow: hidden;
				background: var(--cru-char);
				box-shadow:
					0 20px 60px rgba(0, 0, 0, 0.5),
					0 0 100px rgba(255, 140, 66, 0.05);
			}
			.frame-bar {
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 10px 14px;
				background: rgba(255, 255, 255, 0.02);
				border-bottom: 1px solid var(--cru-rule);
			}
			.frame-dot {
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: var(--cru-slate-deep);
			}
			.frame img {
				display: block;
				width: 100%;
				height: auto;
			}

			.demo-layout {
				max-width: 880px;
			}

			/* ── Comparison ───────────────────────────────────────── */
			.compare-scroll {
				overflow-x: auto;
			}
			.compare {
				width: 100%;
				border-collapse: collapse;
				font-size: var(--cru-size-small);
			}
			.compare th {
				text-align: left;
				padding: 0.9rem 1.1rem;
				font-family: var(--cru-font-mono);
				font-weight: 500;
				font-size: var(--cru-size-micro);
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: var(--cru-dim);
				border-bottom: 1px solid var(--cru-rule-lit);
				white-space: nowrap;
			}
			.compare th.is-crucible {
				color: var(--cru-ember);
			}
			.compare td {
				padding: 0.8rem 1.1rem;
				border-bottom: 1px solid var(--cru-rule);
				color: var(--cru-ash);
				white-space: nowrap;
			}
			.compare td:first-child {
				color: var(--cru-bright);
				font-weight: 500;
			}
			.compare tbody tr:hover td {
				background: rgba(255, 255, 255, 0.015);
			}
			.yes {
				color: var(--cru-ember);
				font-weight: 600;
			}
			.no {
				color: var(--cru-dim);
			}
			.some {
				color: var(--cru-slate);
			}

			/* ── Split section ────────────────────────────────────── */
			.split {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3.5rem;
				align-items: center;
			}
			.split .band-head {
				margin-bottom: 1.75rem;
			}

			/* ── Quick start ──────────────────────────────────────── */
			.term {
				max-width: 660px;
			}
			.term-body {
				padding: 1.4rem 1.5rem;
			}
			.term-line {
				display: flex;
				align-items: baseline;
				font-family: var(--cru-font-mono);
				font-size: 0.82rem;
				line-height: 1.9;
			}
			.term-prompt {
				color: var(--cru-ember);
				user-select: none;
				margin-right: 0.6rem;
				flex-shrink: 0;
			}
			.term-cmd {
				color: var(--cru-bright);
				white-space: nowrap;
			}
			.term-note {
				color: var(--cru-dim);
				margin-left: auto;
				padding-left: 1.5rem;
				white-space: nowrap;
			}

			/* ── Footer ───────────────────────────────────────────── */
			.foot {
				padding: 3rem 0;
				border-top: 1px solid var(--cru-rule);
			}
			.foot-inner {
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 2rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1.5rem;
				flex-wrap: wrap;
			}
			.foot-brand {
				font-family: var(--cru-font-display);
				font-size: 1.15rem;
				color: var(--cru-ember);
			}
			.foot-links {
				display: flex;
				gap: 1.75rem;
				list-style: none;
			}
			.foot-links a {
				color: var(--cru-dim);
				text-decoration: none;
				font-size: var(--cru-size-small);
				transition: color var(--cru-quick) var(--cru-ease);
			}
			.foot-links a:hover {
				color: var(--cru-ash);
			}
			.foot-meta {
				color: var(--cru-dim);
				font-family: var(--cru-font-mono);
				font-size: var(--cru-size-micro);
			}

			/* ── Entrance ─────────────────────────────────────────── */
			.rise {
				animation: rise 0.7s var(--cru-ease) both;
			}
			.d1 {
				animation-delay: 0.06s;
			}
			.d2 {
				animation-delay: 0.12s;
			}
			.d3 {
				animation-delay: 0.18s;
			}
			.d4 {
				animation-delay: 0.24s;
			}

			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.rise {
					animation: none;
				}
			}

			/* ── Responsive ───────────────────────────────────────── */
			@media (max-width: 1000px) {
				/* The engraving drops behind the copy rather than disappearing —
				   losing it entirely would strip the page's identity on phones. */
				.hero-art {
					right: 50%;
					width: min(120vw, 720px);
					transform: translate(50%, -50%);
					opacity: 0.16;
					-webkit-mask-image: radial-gradient(circle, #000 40%, transparent 72%);
					mask-image: radial-gradient(circle, #000 40%, transparent 72%);
				}
				.hero-copy,
				.hero-sub {
					max-width: none;
				}
				.split {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}
				.features {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 640px) {
				.band {
					padding: 4.5rem 0;
				}
				.hero {
					padding-top: 7.5rem;
				}
				.features {
					grid-template-columns: 1fr;
				}
				.nav {
					padding: 0.75rem 1rem;
				}
				.nav-links {
					gap: 0.9rem;
				}
				.wrap,
				.hero-inner,
				.foot-inner {
					padding-inline: 1.25rem;
				}
				.install {
					padding-right: 1.1rem;
					padding-bottom: 3rem;
				}
				.install-copy {
					top: auto;
					bottom: 0.8rem;
					right: 0.8rem;
				}
				.term-line {
					flex-wrap: wrap;
				}
				.term-note {
					margin-left: 1.4rem;
					padding-left: 0;
				}
				.foot-inner {
					justify-content: flex-start;
				}
			}
		</style>
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<nav class="nav">
			<a href={base} class="nav-brand">Crucible</a>
			<ul class="nav-links">
				<li><a href={`${base}guides/getting-started/`}>Docs</a></li>
				<li><a href="https://github.com/Mootikins/crucible">GitHub</a></li>
				<li>
					<a href={`${base}guides/getting-started/`} class="nav-cta">Get Started</a>
				</li>
			</ul>
		</nav>

		<main id="main">
			<!-- Hero -->
			<section class="hero">
				<HeroGraph nodes={heroNodes} edges={heroEdges} />

				<div class="hero-art">
					<img
						src={`${base}art/khunrath-laboratory-900.webp`}
						srcset={`${base}art/khunrath-laboratory-560.webp 560w, ${base}art/khunrath-laboratory-900.webp 900w, ${base}art/khunrath-laboratory-1600.webp 1600w`}
						sizes="(max-width: 1000px) 100vw, 58vw"
						width="900"
						height="916"
						fetchpriority="high"
						alt="Heinrich Khunrath's Alchemist's Laboratory, 1595: a hall split between a study of books and a furnace of glassware, with instruments laid across the table between them."
					/>
				</div>

				<div class="hero-inner">
					<div class="hero-copy">
						<div class="hero-eyebrow rise">
							<span class="label">Local-first agent runtime</span>
						</div>
						<!-- Breaks are set by hand: left to wrap on its own the line
						     rag lands on a lone "AGENTS" and the stack looks accidental. -->
						<h1 class="display rise d1">
							Knowledge<br />makes agents<br /><em>better</em>
						</h1>
						<p class="hero-sub rise d2">
							Your notes, sessions, and wikilinks form a knowledge graph that agents draw
							from and contribute to. Local-first. No cloud. No lock-in. All plaintext.
						</p>

						<div class="install rise d3">
							<span class="label">Install</span>
