---
/**
 * Hover previews that promote to floating windows — Obsidian Hover Editor
 * semantics, ported from the web UI.
 *
 * Hovering an internal doc link spawns a TRANSIENT window next to it, which
 * auto-closes when the pointer leaves both the link and the window. Dragging,
 * resizing, or hitting the pin button promotes it to a persistent window that
 * the hover system stops managing. Links inside a window spawn further windows,
 * so a reader can fan several pages out at once without leaving the page.
 *
 * This is a reimplementation, not a copy. The web UI's FloatingWindow pulls in
 * its whole app — a Solid store over tab groups, docking, split trees, layout
 * serialisation, a panel registry, and dirty-editor guards for editors and
 * terminals. None of that means anything for static docs. What is ported is the
 * part that was expensive to get right: the interaction rules, and the geometry
 * constants, which are kept identical so the two feel like one product.
 *
 * Source: crates/crucible-web/web/src/components/WikilinkHoverPreview.tsx
 *         crates/crucible-web/web/src/components/windowing/FloatingWindow.tsx
 *
 * Progressive enhancement throughout: every link works as a link. Without
 * JavaScript, on touch, on narrow viewports, or under reduced-motion, clicking
 * navigates exactly as before.
 */
---

<div id="doc-windows" aria-live="polite"></div>

<style>
	#doc-windows {
		position: fixed;
		inset: 0;
		/* The layer itself must never eat a click; each window opts back in. */
		pointer-events: none;
		/* Above Starlight's navbar, below its mobile menu overlay. */
		z-index: calc(var(--sl-z-index-navbar, 10) + 10);
	}

	/* Hover previews are a pointer affordance. Touch has no hover, and a
	   480px window on a phone is the whole screen. */
	@media (max-width: 1000px), (pointer: coarse) {
		#doc-windows {
			display: none;
		}
	}
</style>

<style is:global>
	.docwin {
		position: absolute;
		display: flex;
		flex-direction: column;
		pointer-events: auto;
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 6px;
		box-shadow:
			0 12px 32px rgba(0, 0, 0, 0.42),
			0 2px 8px rgba(0, 0, 0, 0.3);
		overflow: hidden;
	}

	:root[data-theme='light'] .docwin {
		box-shadow:
			0 12px 32px rgba(26, 23, 20, 0.16),
			0 2px 8px rgba(26, 23, 20, 0.1);
	}

	/* Pinned windows read as deliberate; transient ones as provisional. */
	.docwin[data-pinned='true'] {
		border-color: var(--cru-ember-edge);
	}

	.docwin-titlebar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.4rem 0.4rem 0.7rem;
		background: var(--sl-color-gray-6);
		border-bottom: 1px solid var(--sl-color-hairline);
		cursor: grab;
		user-select: none;
		flex-shrink: 0;
	}

	.docwin-titlebar:active {
		cursor: grabbing;
	}

	.docwin-title {
		font-family: var(--cru-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;
		min-width: 0;
	}

	.docwin-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		flex-shrink: 0;
		border: 0;
		border-radius: 3px;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
		padding: 0;
	}

	.docwin-btn:hover {
		background: var(--cru-ember-wash);
		color: var(--sl-color-white);
	}

	.docwin-btn[data-active='true'] {
		color: var(--cru-ember-text);
	}

	.docwin-body {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.9rem 1.1rem 1.4rem;
	}

	/* The preview is a reading surface, not a page: dial the display type
	   down so a 480px window is not all headline. */
	.docwin-body :is(h1, h2, h3, h4) {
		font-size: 1rem;
		font-weight: 600;
		font-family: var(--cru-font-body);
		letter-spacing: normal;
		margin: 1.2rem 0 0.4rem;
		border-top: 0;
		padding-top: 0;
		color: var(--sl-color-white);
	}

	.docwin-body > :first-child {
		margin-top: 0;
	}

	/* Starlight's heading anchor links are positioned against the heading in a
	   real page. Copied into a preview they detach and render as a stray link
	   glyph on its own line — and they would only deep-link out of the window
	   anyway. */
	.docwin-body .sl-anchor-link {
		display: none;
	}

	.docwin-body {
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--sl-color-text);
	}

	.docwin-body p,
	.docwin-body ul,
	.docwin-body ol,
	.docwin-body pre,
	.docwin-body table {
		margin: 0 0 0.75rem;
	}

	.docwin-body a {
		color: var(--sl-color-text-accent);
	}

	.docwin-body pre {
		font-size: 0.78rem;
		padding: 0.6rem 0.75rem;
		border-radius: 4px;
		overflow-x: auto;
	}

	.docwin-body img {
		max-width: 100%;
		height: auto;
	}

	.docwin-status {
		padding: 1rem 1.1rem;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}

	.docwin-resize {
		position: absolute;
	}

	.docwin-anim {
		animation: docwin-pop 0.13s cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	@keyframes docwin-pop {
		from {
			opacity: 0;
			transform: scale(0.985);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.docwin-anim {
			animation: none;
		}
	}
</style>

<script>
	// ── Constants, kept identical to the web UI where they exist there ──────
	// FloatingWindow.tsx
	const MIN_WIDTH = 240;
	const MIN_HEIGHT = 160;
	// WikilinkHoverPreview.tsx
	const SHOW_DELAY_MS = 300;
	const HIDE_DELAY_MS = 300;
	const EDGE_GAP_PX = 8;
	// Wider than the app's 460x320: that window holds an editor, this one holds
	// prose, and doc paragraphs need the extra measure to avoid ragging badly.
	const WINDOW_WIDTH = 480;
	const WINDOW_HEIGHT = 380;

	type ResizeEdge = 'n' | 's' | 'e' | 'w' | 'nw' | 'ne' | 'sw' | 'se';

	const HANDLE_DEFS: { edge: ResizeEdge; cursor: string; css: Partial<CSSStyleDeclaration> }[] = [
		{ edge: 'n', cursor: 'n-resize', css: { top: '-2px', left: '12px', right: '12px', height: '6px', zIndex: '1' } },
		{ edge: 's', cursor: 's-resize', css: { bottom: '-2px', left: '12px', right: '12px', height: '6px', zIndex: '1' } },
		{ edge: 'w', cursor: 'w-resize', css: { left: '-2px', top: '12px', bottom: '12px', width: '6px', zIndex: '1' } },
		{ edge: 'e', cursor: 'e-resize', css: { right: '-2px', top: '12px', bottom: '12px', width: '6px', zIndex: '1' } },
		{ edge: 'nw', cursor: 'nw-resize', css: { top: '-2px', left: '-2px', width: '12px', height: '12px', zIndex: '2' } },
		{ edge: 'ne', cursor: 'ne-resize', css: { top: '-2px', right: '-2px', width: '12px', height: '12px', zIndex: '2' } },
		{ edge: 'sw', cursor: 'sw-resize', css: { bottom: '-2px', left: '-2px', width: '12px', height: '12px', zIndex: '2' } },
		{ edge: 'se', cursor: 'se-resize', css: { bottom: '-2px', right: '-2px', width: '12px', height: '12px', zIndex: '2' } },
	];

	const LINK_SELECTOR = [
		'.sl-markdown-content a[href]',
		'.localgraph a[href]',
		'.pagination-links a[href]',
		'.docwin-body a[href]',
	].join(', ');

	const layer = document.getElementById('doc-windows');

	// The layer is display:none under the media query above; bail rather than
	// run a hover system nobody can see.
	if (layer && getComputedStyle(layer).display !== 'none') {
		type Win = {
			id: string;
			url: string;
			pinned: boolean;
			x: number;
			y: number;
			w: number;
			h: number;
			el: HTMLElement;
		};

		const wins: Win[] = [];
		const cache = new Map<string, { title: string; html: string } | null>();
		let seq = 0;
		let z = 1;

		// Hover state. `currentUrl` and `anchorRect` are tracked alongside the
		// element because the element can go stale under a stationary pointer.
		let hoverWinId: string | null = null;
		let currentAnchor: Element | null = null;
		let currentUrl: string | null = null;
		let anchorRect: DOMRect | null = null;
		let showTimer = 0;
		let hideTimer = 0;

		const byId = (id: string | null) => wins.find((w) => w.id === id);
		const clearTimers = () => {
			window.clearTimeout(showTimer);
			window.clearTimeout(hideTimer);
		};

		// ── Eligibility ────────────────────────────────────────────────────
		function previewUrl(a: Element): string | null {
			const href = a.getAttribute('href');
			if (!href || href.startsWith('#')) return null;
			let url: URL;
			try {
				url = new URL(href, location.href);
			} catch {
				return null;
			}
			if (url.origin !== location.origin) return null;
			if (!url.pathname.startsWith(import.meta.env.BASE_URL)) return null;
			// Previewing the page you are already reading is noise.
			if (url.pathname === location.pathname) return null;
			return url.origin + url.pathname;
		}

		/**
		 * Whether hovering `target` should spawn a preview for `anchor`.
		 *
		 * In the neighbourhood graph a node is one <a> wrapping both a dot and a
		 * label, but the two have different jobs: the dot is the drag handle, so
		 * previews come from the label only. Otherwise picking a node up spawns a
		 * window over the graph you are rearranging.
		 */
		function previewable(target: Element, anchor: Element) {
			if (!anchor.classList?.contains('node-link')) return true;
			// Never mid-drag, whichever part the pointer happens to be over.
			if (anchor.closest('svg')?.hasAttribute('data-dragging')) return false;
			return !!target.closest?.('.node-label');
		}

		async function loadPage(url: string) {
			// Successes are cached forever; failures are not. A transient network
			// blip would otherwise mark a page permanently unavailable for the
			// rest of the session.
			if (cache.get(url)) return cache.get(url);
			try {
				const res = await fetch(url, {
					credentials: 'same-origin',
					signal: AbortSignal.timeout(8000),
				});
				if (!res.ok) throw new Error(String(res.status));
				const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
				const content = doc.querySelector('.sl-markdown-content');
				if (!content) throw new Error('no content');
				const title =
					doc.querySelector('.content-panel h1')?.textContent?.trim() ||
					doc.title.split('|')[0].trim();
				cache.set(url, { title, html: content.innerHTML });
			} catch {
				cache.delete(url);
				return null;
			}
			return cache.get(url);
		}

		// ── Window construction ────────────────────────────────────────────
		function bringToFront(win: Win) {
			win.el.style.zIndex = String(++z);
		}

		function place(win: Win) {
			win.el.style.left = `${win.x}px`;
			win.el.style.top = `${win.y}px`;
			win.el.style.width = `${win.w}px`;
			win.el.style.height = `${win.h}px`;
		}

		function close(win: Win) {
			win.el.remove();
			const i = wins.indexOf(win);
			if (i >= 0) wins.splice(i, 1);
			if (hoverWinId === win.id) hoverWinId = null;
		}

		function pin(win: Win) {
			if (win.pinned) return;
			win.pinned = true;
			win.el.dataset.pinned = 'true';
			const btn = win.el.querySelector<HTMLElement>('[data-role="pin"]');
			if (btn) {
				btn.dataset.active = 'true';
				btn.setAttribute('aria-pressed', 'true');
				btn.title = 'Unpin (closes when the pointer leaves)';
			}
			// Once pinned the window is the reader's, not the hover system's.
			if (hoverWinId === win.id) hoverWinId = null;
		}

		function unpin(win: Win) {
			win.pinned = false;
			win.el.dataset.pinned = 'false';
			const btn = win.el.querySelector<HTMLElement>('[data-role="pin"]');
			if (btn) {
				btn.dataset.active = 'false';
				btn.setAttribute('aria-pressed', 'false');
				btn.title = 'Keep open';
			}
		}

		function icon(paths: string, filled = false) {
			return `<svg width="13" height="13" viewBox="0 0 24 24" fill="${
				filled ? 'currentColor' : 'none'
			}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
		}

		const PIN_ICON = icon('<path d="M12 17v5"/><path d="M9 10.76V7a3 3 0 0 1 6 0v3.76a2 2 0 0 0 .59 1.42L17 13.5V17H7v-3.5l1.41-1.32A2 2 0 0 0 9 10.76Z"/>');
		const CLOSE_ICON = icon('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>');

		function makeWindow(
			url: string,
			title: string,
			x: number,
			y: number,
			width = WINDOW_WIDTH,
			height = WINDOW_HEIGHT
		): Win {
			const el = document.createElement('div');
			el.className = 'docwin docwin-anim';
			el.dataset.pinned = 'false';
			el.setAttribute('role', 'dialog');
			el.setAttribute('aria-label', `Preview: ${title}`);
			el.tabIndex = -1;

			el.innerHTML = `
				<div class="docwin-titlebar" data-role="titlebar">
					<span class="docwin-title"></span>
					<button class="docwin-btn" data-role="pin" data-active="false" aria-pressed="false" title="Keep open" type="button">${PIN_ICON}</button>
					<button class="docwin-btn" data-role="close" title="Close" type="button">${CLOSE_ICON}</button>
				</div>
				<div class="docwin-body"></div>
			`;
			el.querySelector('.docwin-title')!.textContent = title;

			const win: Win = {
				id: `docwin-${++seq}`,
				url,
				pinned: false,
				x,
				y,
				w: width,
				h: height,
				el,
			};
			el.dataset.windowId = win.id;
			place(win);

			for (const h of HANDLE_DEFS) {
				const grip = document.createElement('div');
				grip.className = 'docwin-resize';
				Object.assign(grip.style, h.css, { cursor: h.cursor });
				grip.addEventListener('pointerdown', (e) => startResize(win, h.edge, e));
				el.appendChild(grip);
			}

			el.addEventListener('pointerdown', () => bringToFront(win));
			el.querySelector('[data-role="titlebar"]')!.addEventListener(
				'mousedown',
				(e) => startDrag(win, e as MouseEvent)
			);
			el.querySelector('[data-role="close"]')!.addEventListener('click', (e) => {
				e.stopPropagation();
				close(win);
			});
			el.querySelector('[data-role="pin"]')!.addEventListener('click', (e) => {
				e.stopPropagation();
				win.pinned ? unpin(win) : pin(win);
			});

			layer!.appendChild(el);
			wins.push(win);
			bringToFront(win);
			return win;
		}

		// ── Drag ───────────────────────────────────────────────────────────
		function startDrag(win: Win, e: MouseEvent) {
			// Interacting with a transient window's geometry means the reader
			// wants to keep it. Same auto-pin rule as the web UI.
			pin(win);
			e.preventDefault();
			bringToFront(win);

			const sx = e.clientX;
			const sy = e.clientY;
			const ox = win.x;
			const oy = win.y;

			const move = (ev: MouseEvent) => {
				// Clamped on all four edges. Clamping only the top-left let a
				// window be dragged almost entirely off the right or bottom,
				// with no way to bring it back.
				const maxX = Math.max(0, window.innerWidth - win.w);
				const maxY = Math.max(0, window.innerHeight - win.h);
				win.x = Math.min(maxX, Math.max(0, ox + ev.clientX - sx));
				win.y = Math.min(maxY, Math.max(0, oy + ev.clientY - sy));
				place(win);
			};
			const up = () => {
				document.removeEventListener('mousemove', move);
				document.removeEventListener('mouseup', up);
			};
			document.addEventListener('mousemove', move);
			document.addEventListener('mouseup', up);
		}

		// ── Resize ─────────────────────────────────────────────────────────
		function startResize(win: Win, edge: ResizeEdge, e: PointerEvent) {
			pin(win);
			e.preventDefault();
			e.stopPropagation();
			bringToFront(win);
			const grip = e.currentTarget as HTMLElement;
			grip.setPointerCapture(e.pointerId);

			const sx = e.clientX;
			const sy = e.clientY;
			const ox = win.x;
			const oy = win.y;
			const ow = win.w;
			const oh = win.h;

			const affectsLeft = edge.includes('w');
			const affectsTop = edge.includes('n');
			const movesWidth = edge === 'e' || edge === 'w' || edge.length === 2;
			const movesHeight = edge === 'n' || edge === 's' || edge.length === 2;

			const move = (ev: PointerEvent) => {
				const dx = ev.clientX - sx;
				const dy = ev.clientY - sy;
				let x = ox;
				let y = oy;
				let w = ow;
				let h = oh;

				if (movesWidth) {
					if (affectsLeft) {
						w = Math.max(MIN_WIDTH, ow - dx);
						x = ox + ow - w;
						// Dragging a left edge past the viewport edge must trade
						// width for position, not push the window off-screen.
						if (x < 0) {
							w += x;
							x = 0;
							w = Math.max(MIN_WIDTH, w);
						}
					} else {
						w = Math.max(MIN_WIDTH, ow + dx);
					}
				}

				if (movesHeight) {
					if (affectsTop) {
						h = Math.max(MIN_HEIGHT, oh - dy);
						y = oy + oh - h;
						if (y < 0) {
							h += y;
							y = 0;
							h = Math.max(MIN_HEIGHT, h);
						}
					} else {
						h = Math.max(MIN_HEIGHT, oh + dy);
					}
				}

				win.x = x;
				win.y = y;
				win.w = w;
				win.h = h;
				place(win);
			};

			const up = (ev: PointerEvent) => {
				grip.releasePointerCapture(ev.pointerId);
				document.removeEventListener('pointermove', move);
				document.removeEventListener('pointerup', up);
			};

			document.addEventListener('pointermove', move);
			document.addEventListener('pointerup', up);
		}

		// ── Spawning ───────────────────────────────────────────────────────
		function anchorPosition(rect: DOMRect) {
			// A window taller than the viewport can never be placed on-screen,
			// so shrink it first and position the real height.
			const h = Math.min(WINDOW_HEIGHT, window.innerHeight - EDGE_GAP_PX * 2);
			const w = Math.min(WINDOW_WIDTH, window.innerWidth - EDGE_GAP_PX * 2);

			const left = Math.max(
				EDGE_GAP_PX,
				Math.min(rect.left, window.innerWidth - w - EDGE_GAP_PX)
			);

			// Hug the anchor. A taller gap exposes the next link in a list, so
			// the pointer crosses it on the way to the window and spawns ITS
			// preview instead.
			const fitsBelow = rect.bottom + h + EDGE_GAP_PX <= window.innerHeight;
			let top = fitsBelow ? rect.bottom + 2 : rect.top - h - 2;

			// Clamp into the viewport. Choosing above-or-below is a preference,
			// not a guarantee: an anchor low in a window whose own rect sits near
			// the fold produced a preview 324px past the bottom edge. Overlapping
			// the anchor is a far better failure than being unreachable.
			top = Math.max(EDGE_GAP_PX, Math.min(top, window.innerHeight - h - EDGE_GAP_PX));

			return { left, top, width: w, height: h };
		}

		async function show(anchor: Element, url: string) {
			currentAnchor = anchor;
			currentUrl = url;
			anchorRect = anchor.getBoundingClientRect();

			// Already open — including a window the reader pinned earlier.
			const open = wins.find((w) => w.url === url);
			if (open) {
				if (!open.pinned) hoverWinId = open.id;
				bringToFront(open);
				return;
			}

			const { left, top, width, height } = anchorPosition(anchorRect);
			const win = makeWindow(url, 'Loading…', left, top, width, height);
			hoverWinId = win.id;
			const body = win.el.querySelector<HTMLElement>('.docwin-body')!;
			body.innerHTML = '<p class="docwin-status">Loading…</p>';

			const page = await loadPage(url);
			// Superseded or dismissed while fetching.
			if (!byId(win.id)) return;

			if (!page) {
				body.innerHTML = '<p class="docwin-status">Could not load this page.</p>';
				win.el.querySelector('.docwin-title')!.textContent = 'Unavailable';
				return;
			}
			win.el.querySelector('.docwin-title')!.textContent = page.title;
			win.el.setAttribute('aria-label', `Preview: ${page.title}`);
			body.innerHTML = page.html;
		}

		function dismissTransient() {
			currentAnchor = null;
			currentUrl = null;
			anchorRect = null;
			const win = byId(hoverWinId);
			hoverWinId = null;
			if (win && !win.pinned) close(win);
		}

		// ── Hover routing ──────────────────────────────────────────────────
		document.addEventListener('mouseover', (event) => {
			const target = event.target as Element | null;
			if (!target) return;

			// Pointer inside the transient window keeps it open, and cancels a
			// pending show from a link crossed on the way in.
			if (hoverWinId && target.closest?.(`[data-window-id="${hoverWinId}"]`)) {
				clearTimers();
				return;
			}

			// Transit corridor: with a window open, the strip between the anchor
			// and the window's near edge belongs to the hover. Links inside it
			// must not fire while the pointer is merely travelling.
			const win = byId(hoverWinId);
			if (win && anchorRect) {
				const withinX =
					event.clientX >= Math.min(win.x, anchorRect.left) - 8 &&
					event.clientX <= Math.max(win.x + win.w, anchorRect.right) + 8;
				const belowPath =
					win.y >= anchorRect.bottom &&
					event.clientY >= anchorRect.top &&
					event.clientY <= win.y + 4;
				const abovePath =
					win.y + win.h <= anchorRect.top &&
					event.clientY <= anchorRect.bottom &&
					event.clientY >= win.y + win.h - 4;
				if (withinX && (belowPath || abovePath)) {
					clearTimers();
					return;
				}
			}

			const anchor = target.closest?.(LINK_SELECTOR);
			const url = anchor && previewable(target, anchor) ? previewUrl(anchor) : null;

			if (anchor && url) {
				window.clearTimeout(hideTimer);
				// Same link (or the same target re-rendered): keep what is open.
				if (anchor === currentAnchor || url === currentUrl) {
					currentAnchor = anchor;
					currentUrl = url;
					anchorRect = anchor.getBoundingClientRect();
					return;
				}
				window.clearTimeout(showTimer);
				if (hoverWinId) hideTimer = window.setTimeout(dismissTransient, HIDE_DELAY_MS);
				showTimer = window.setTimeout(() => void show(anchor, url), SHOW_DELAY_MS);
				return;
			}

			// A DOM change under a STATIONARY pointer re-fires mouseover with a
			// non-anchor target at the same coordinates. That is not "hovering
			// away" — only positions outside the anchor's rect count as leaving.
			if (
				anchorRect &&
				event.clientX >= anchorRect.left - 8 &&
				event.clientX <= anchorRect.right + 8 &&
				event.clientY >= anchorRect.top - 8 &&
				event.clientY <= anchorRect.bottom + 8
			) {
				return;
			}

			window.clearTimeout(showTimer);
			if (currentAnchor || hoverWinId) {
				window.clearTimeout(hideTimer);
				hideTimer = window.setTimeout(() => {
					const w = byId(hoverWinId);
					// Pinned mid-hover: no longer ours to close.
					if (w && w.pinned) {
						hoverWinId = null;
						currentAnchor = null;
						currentUrl = null;
						anchorRect = null;
						return;
					}
					dismissTransient();
				}, HIDE_DELAY_MS);
			}
		});

		// Escape closes the top window — the only way out for a reader who has
		// pinned several and does not want to hunt for close buttons.
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape' || wins.length === 0) return;
			// Starlight's search is a <dialog> with its own Escape handling;
			// closing a doc window at the same time makes one keypress do two
			// unrelated things.
			if (document.querySelector('dialog[open]')) return;
			const top = wins.reduce((a, b) =>
				Number(a.el.style.zIndex) >= Number(b.el.style.zIndex) ? a : b
			);
			close(top);
		});
	}
</script>
