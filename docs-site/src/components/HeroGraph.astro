---
/**
 * The hero constellation.
 *
 * Draws the documentation's actual link graph — the same edges the per-page
 * widget draws — spread across the whole hero, drifting continuously, and
 * parting around the cursor.
 *
 * Canvas 2D, not WebGL: ~60 nodes is nowhere near needing a GPU, and 2D has no
 * context-loss handling, no shader compile step, and a far better worst case on
 * weak hardware. Reaching for WebGL here would cost more than it bought.
 */
interface GraphNode {
	slug: string;
	section: string;
	degree: number;
}
interface GraphEdge {
	from: string;
	to: string;
}
interface Props {
	nodes: GraphNode[];
	edges: GraphEdge[];
}
const { nodes, edges } = Astro.props;
---

<canvas
	class="hero-graph"
	aria-hidden="true"
	data-graph={JSON.stringify({ nodes, edges })}></canvas>

<style>
	.hero-graph {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: none;
		z-index: 0;
		/* The graph runs under the copy, so it is held back there rather than
		   fenced out — the field should read as continuous, but the headline
		   still has to win. Full strength everywhere else. */
		-webkit-mask-image: linear-gradient(
			to right,
			rgba(0, 0, 0, 0.42) 0%,
			rgba(0, 0, 0, 0.42) 40%,
			#000 62%
		);
		mask-image: linear-gradient(
			to right,
			rgba(0, 0, 0, 0.42) 0%,
			rgba(0, 0, 0, 0.42) 40%,
			#000 62%
		);
	}

	/* Below the wide breakpoint the copy fills the viewport, so there is no
	   "background" left to cover. The engraving wash carries the identity. */
	@media (max-width: 1000px) {
		.hero-graph {
			display: none;
		}
	}
</style>

<script>
	type Node = {
		slug: string;
		section: string;
		degree: number;
		/** Settled position. Everything else is an offset from here. */
		hx: number;
		hy: number;
		/** Simulation scratch, used only while settling. */
		x: number;
		y: number;
		vx: number;
		vy: number;
		/** Cursor displacement and its velocity. */
		dx: number;
		dy: number;
		dvx: number;
		dvy: number;
		/** Per-node drift phases, so nothing moves in lockstep. */
		p1: number;
		p2: number;
		amp: number;
		heat: number;
		/** Rendered position for this frame. */
		rx: number;
		ry: number;
	};

	const canvas = document.querySelector<HTMLCanvasElement>('.hero-graph');
	if (canvas) {
		const ctx = canvas.getContext('2d', { alpha: true })!;
		const raw = JSON.parse(canvas.dataset.graph!) as {
			nodes: { slug: string; section: string; degree: number }[];
			edges: { from: string; to: string }[];
		};

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		// Deterministic PRNG. The layout must be identical on every load and on
		// every resize — a constellation that reshuffles when you rotate your
		// phone reads as a bug, not as life.
		function makeRng(seed: number) {
			let s = seed >>> 0;
			return () => {
				s = (s * 1664525 + 1013904223) >>> 0;
				return s / 4294967296;
			};
		}

		let nodes: Node[] = [];
		let links: { a: Node; b: Node }[] = [];
		let W = 0,
			H = 0,
			DPR = 1;

		const pointer = { x: -9999, y: -9999, active: false };

		// Cursor interaction. Nodes are pushed out of the way and spring back;
		// the radius is generous so the effect reads as the field parting rather
		// than as individual dots twitching.
		const PUSH_RADIUS = 165;
		const PUSH_STRENGTH = 0.9;
		const SPRING = 0.045;
		const DAMPING = 0.86;

		function measure() {
			const rect = canvas!.getBoundingClientRect();
			W = rect.width;
			H = rect.height;
			DPR = Math.min(window.devicePixelRatio || 1, 2);
			canvas!.width = Math.round(W * DPR);
			canvas!.height = Math.round(H * DPR);
			ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
		}

		function layout() {
			const rng = makeRng(0x63727563); // 'cruc'
			const byId = new Map<string, Node>();

			// Jittered grid rather than pure random: random scatter clumps and
			// leaves bald patches, which is exactly what "covers the background"
			// must not look like.
			const cols = Math.ceil(Math.sqrt(raw.nodes.length * (W / Math.max(H, 1))));
			const rows = Math.ceil(raw.nodes.length / cols);
			const cellW = W / cols;
			const cellH = H / rows;

			nodes = raw.nodes.map((n, i) => {
				const cx = (i % cols) + 0.5;
				const cy = Math.floor(i / cols) + 0.5;
				const x = (cx + (rng() - 0.5) * 0.7) * cellW;
				const y = (cy + (rng() - 0.5) * 0.7) * cellH;
				const node: Node = {
					...n,
					hx: x,
					hy: y,
					x,
					y,
					vx: 0,
					vy: 0,
					dx: 0,
					dy: 0,
					dvx: 0,
					dvy: 0,
					p1: rng() * Math.PI * 2,
					p2: rng() * Math.PI * 2,
					// Varied amplitude so the field breathes unevenly.
					amp: 6 + rng() * 9,
					heat: 0,
					rx: x,
					ry: y,
				};
				byId.set(n.slug, node);
				return node;
			});

			links = raw.edges
				.map((e) => ({ a: byId.get(e.from)!, b: byId.get(e.to)! }))
				.filter((l) => l.a && l.b);

			// Light settling only. The grid already covers the field evenly; the
			// springs just pull linked pages a little closer so the shape carries
			// some of the real structure. Running this to convergence collapses
			// the even coverage into clusters and bald patches.
			const PAD = 18;
			const ITERS = 70;
			for (let iter = 0; iter < ITERS; iter++) {
				const cool = 1 - iter / ITERS;

				for (const l of links) {
					const dx = l.b.x - l.a.x;
					const dy = l.b.y - l.a.y;
					const dist = Math.hypot(dx, dy) || 1;
					const f = ((dist - 150) / dist) * 0.006 * cool;
					l.a.vx += dx * f;
					l.a.vy += dy * f;
					l.b.vx -= dx * f;
					l.b.vy -= dy * f;
				}

				for (let i = 0; i < nodes.length; i++) {
					for (let j = i + 1; j < nodes.length; j++) {
						const a = nodes[i];
						const b = nodes[j];
						const dx = b.x - a.x;
						const dy = b.y - a.y;
						const d2 = dx * dx + dy * dy || 1;
						if (d2 > 26000) continue;
						const f = (700 / d2) * cool;
						a.vx -= dx * f;
						a.vy -= dy * f;
						b.vx += dx * f;
						b.vy += dy * f;
					}
				}

				for (const n of nodes) {
					n.x += n.vx;
					n.y += n.vy;
					n.vx *= 0.8;
					n.vy *= 0.8;
					n.x = Math.max(PAD, Math.min(W - PAD, n.x));
					n.y = Math.max(PAD, Math.min(H - PAD, n.y));
				}
			}

			for (const n of nodes) {
				n.hx = n.x;
				n.hy = n.y;
			}
		}

		// Ember ramp, matched to tokens.css.
		const EMBER = [255, 140, 66];
		const FLAME = [255, 170, 51];

		function mix(a: number[], b: number[], t: number) {
			return [
				Math.round(a[0] + (b[0] - a[0]) * t),
				Math.round(a[1] + (b[1] - a[1]) * t),
				Math.round(a[2] + (b[2] - a[2]) * t),
			];
		}

		let t = 0;

		function step(animate: boolean) {
			if (animate) t += 0.006;

			for (const n of nodes) {
				// Continuous drift: two frequencies per node so the path is a
				// slow wander rather than a visible circle or a shared pulse.
				const wx = animate
					? Math.cos(t * 0.8 + n.p1) * n.amp + Math.sin(t * 0.37 + n.p2) * n.amp * 0.5
					: 0;
				const wy = animate
					? Math.sin(t * 0.63 + n.p2) * n.amp + Math.cos(t * 0.29 + n.p1) * n.amp * 0.5
					: 0;

				const baseX = n.hx + wx;
				const baseY = n.hy + wy;

				if (pointer.active && animate) {
					const px = baseX + n.dx - pointer.x;
					const py = baseY + n.dy - pointer.y;
					const dist = Math.hypot(px, py) || 1;
					if (dist < PUSH_RADIUS) {
						// Falloff is squared so the push is soft at the rim and
						// firm up close.
						const falloff = (1 - dist / PUSH_RADIUS) ** 2;
						n.dvx += (px / dist) * falloff * PUSH_STRENGTH * 4;
						n.dvy += (py / dist) * falloff * PUSH_STRENGTH * 4;
						n.heat += (falloff - n.heat) * 0.16;
					} else {
						n.heat += (0 - n.heat) * 0.06;
					}
				} else {
					n.heat += (0 - n.heat) * 0.06;
				}

				// Spring the displacement back to zero, damped — nodes return
				// to their place after the cursor passes instead of drifting off.
				n.dvx -= n.dx * SPRING;
				n.dvy -= n.dy * SPRING;
				n.dvx *= DAMPING;
				n.dvy *= DAMPING;
				n.dx += n.dvx;
				n.dy += n.dvy;

				n.rx = baseX + n.dx;
				n.ry = baseY + n.dy;
			}
		}

		// A pair that ends up far apart is drawn faintly or not at all: a long
		// hairline across the hero reads as a stray scratch, not a relationship.
		const FADE_FROM = 210;
		const FADE_TO = 360;

		function draw() {
			ctx.clearRect(0, 0, W, H);

			for (const l of links) {
				const span = Math.hypot(l.b.rx - l.a.rx, l.b.ry - l.a.ry);
				if (span > FADE_TO) continue;
				const near = 1 - Math.max(0, (span - FADE_FROM) / (FADE_TO - FADE_FROM));
				const heat = Math.max(l.a.heat, l.b.heat);
				const [r, g, b] = mix(EMBER, FLAME, heat);
				ctx.strokeStyle = `rgba(${r},${g},${b},${(0.2 + heat * 0.4) * near})`;
				ctx.lineWidth = 0.7 + heat * 0.7;
				ctx.beginPath();
				ctx.moveTo(l.a.rx, l.a.ry);
				ctx.lineTo(l.b.rx, l.b.ry);
				ctx.stroke();
			}

			for (const n of nodes) {
				const size = 1.5 + Math.min(n.degree, 14) * 0.13 + n.heat * 1.4;
				const [r, g, b] = mix(EMBER, FLAME, n.heat);

				if (n.heat > 0.03) {
					ctx.fillStyle = `rgba(${r},${g},${b},${n.heat * 0.1})`;
					ctx.beginPath();
					ctx.arc(n.rx, n.ry, size * 5, 0, Math.PI * 2);
					ctx.fill();
				}

				ctx.fillStyle = `rgba(${r},${g},${b},${0.42 + n.heat * 0.5})`;
				ctx.beginPath();
				ctx.arc(n.rx, n.ry, size, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		let raf = 0;
		let running = false;

		function frame() {
			step(true);
			draw();
			raf = requestAnimationFrame(frame);
		}

		/** Hidden by CSS below 1000px, which collapses the canvas to 0x0. */
		function hidden() {
			return W === 0 || H === 0;
		}

		function start() {
			if (running || reduceMotion.matches || hidden()) return;
			running = true;
			raf = requestAnimationFrame(frame);
		}
		function stop() {
			running = false;
			cancelAnimationFrame(raf);
		}

		function rebuild() {
			measure();
			if (hidden()) {
				stop();
				return;
			}
			layout();
			step(false);
			draw();
		}

		rebuild();

		// Only animate while the hero is actually on screen. Scrolling away from
		// a landing page should not leave a rAF loop burning battery.
		const hero = canvas.closest('section') ?? canvas.parentElement!;
		new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), {
			threshold: 0,
		}).observe(hero);

		document.addEventListener('visibilitychange', () => {
			document.hidden ? stop() : start();
		});

		let resizeTimer = 0;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(rebuild, 150);
		});

		// Pointer tracking lives on the hero, not the canvas — the canvas is
		// pointer-events:none so it never intercepts a click on the CTA.
		hero.addEventListener('pointermove', (e) => {
			if (reduceMotion.matches) return;
			const rect = canvas.getBoundingClientRect();
			pointer.x = (e as PointerEvent).clientX - rect.left;
			pointer.y = (e as PointerEvent).clientY - rect.top;
			pointer.active = true;
		});
		hero.addEventListener('pointerleave', () => {
			pointer.active = false;
		});

		reduceMotion.addEventListener('change', () => {
			stop();
			rebuild();
			start();
		});
	}
</script>
